<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions name="AccountService"
    targetNamespace="http://harbourpoint.example/bank/v1"
    xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:hpb="http://harbourpoint.example/bank/v1">

  <wsdl:types>
    <xsd:schema>
      <xsd:import namespace="http://harbourpoint.example/bank/v1" schemaLocation="AccountService.xsd"/>
    </xsd:schema>
  </wsdl:types>

  <wsdl:message name="HeaderMsg"><wsdl:part name="header" element="hpb:Header"/></wsdl:message>
  <wsdl:message name="ErrorMsg"><wsdl:part name="error" element="hpb:Error"/></wsdl:message>
  <wsdl:message name="GetAccountSummaryIn"><wsdl:part name="parameters" element="hpb:GetAccountSummaryRequest"/></wsdl:message>
  <wsdl:message name="GetAccountSummaryOut"><wsdl:part name="parameters" element="hpb:GetAccountSummaryResponse"/></wsdl:message>
  <wsdl:message name="GetTransactionHistoryIn"><wsdl:part name="parameters" element="hpb:GetTransactionHistoryRequest"/></wsdl:message>
  <wsdl:message name="GetTransactionHistoryOut"><wsdl:part name="parameters" element="hpb:GetTransactionHistoryResponse"/></wsdl:message>

  <wsdl:portType name="AccountServicePortType">
    <wsdl:operation name="GetAccountSummary">
      <wsdl:input message="hpb:GetAccountSummaryIn"/>
      <wsdl:output message="hpb:GetAccountSummaryOut"/>
      <wsdl:fault name="Error" message="hpb:ErrorMsg"/>
    </wsdl:operation>
    <wsdl:operation name="GetTransactionHistory">
      <wsdl:input message="hpb:GetTransactionHistoryIn"/>
      <wsdl:output message="hpb:GetTransactionHistoryOut"/>
      <wsdl:fault name="Error" message="hpb:ErrorMsg"/>
    </wsdl:operation>
  </wsdl:portType>

  <wsdl:binding name="AccountServiceBinding" type="hpb:AccountServicePortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="GetAccountSummary">
      <soap:operation soapAction="http://harbourpoint.example/bank/v1/GetAccountSummary" style="document"/>
      <wsdl:input>
        <soap:body use="literal" parts="parameters"/>
        <soap:header message="hpb:HeaderMsg" part="header" use="literal"/>
      </wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
      <wsdl:fault name="Error"><soap:fault name="Error" use="literal"/></wsdl:fault>
    </wsdl:operation>
    <wsdl:operation name="GetTransactionHistory">
      <soap:operation soapAction="http://harbourpoint.example/bank/v1/GetTransactionHistory" style="document"/>
      <wsdl:input>
        <soap:body use="literal" parts="parameters"/>
        <soap:header message="hpb:HeaderMsg" part="header" use="literal"/>
      </wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
      <wsdl:fault name="Error"><soap:fault name="Error" use="literal"/></wsdl:fault>
    </wsdl:operation>
  </wsdl:binding>

  <wsdl:service name="AccountService">
    <wsdl:port name="AccountServicePort" binding="hpb:AccountServiceBinding">
      <soap:address location="http://localhost:7800/account"/>
    </wsdl:port>
  </wsdl:service>
</wsdl:definitions>
