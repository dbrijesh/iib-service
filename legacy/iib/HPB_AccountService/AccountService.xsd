<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns:hpb="http://harbourpoint.example/bank/v1"
            targetNamespace="http://harbourpoint.example/bank/v1"
            elementFormDefault="qualified">

  <xsd:include schemaLocation="../HPB_CommonLib/hpb-common.xsd"/>

  <xsd:element name="GetAccountSummaryRequest">
    <xsd:complexType><xsd:sequence>
      <xsd:element name="accountId" type="xsd:string"/>
    </xsd:sequence></xsd:complexType>
  </xsd:element>
  <xsd:element name="GetAccountSummaryResponse">
    <xsd:complexType><xsd:sequence>
      <xsd:element name="accountId"        type="xsd:string"/>
      <xsd:element name="customerId"       type="xsd:string"/>
      <xsd:element name="product"          type="xsd:string"/>
      <xsd:element name="sortCode"         type="xsd:string"/>
      <xsd:element name="currency"         type="xsd:string"/>
      <xsd:element name="ledgerBalance"    type="xsd:decimal"/>
      <xsd:element name="overdraftLimit"   type="xsd:decimal"/>
      <xsd:element name="holdsTotal"       type="xsd:decimal"/>
      <xsd:element name="availableBalance" type="xsd:decimal"/>
      <xsd:element name="frozen"           type="xsd:boolean"/>
    </xsd:sequence></xsd:complexType>
  </xsd:element>

  <xsd:element name="GetTransactionHistoryRequest">
    <xsd:complexType><xsd:sequence>
      <xsd:element name="accountId"       type="xsd:string"/>
      <xsd:element name="fromDate"        type="xsd:date"/>
      <xsd:element name="toDate"          type="xsd:date"/>
      <xsd:element name="pageSize"        type="xsd:int"  minOccurs="0"/>
      <xsd:element name="continuationKey" type="xsd:long" minOccurs="0"/>
    </xsd:sequence></xsd:complexType>
  </xsd:element>
  <xsd:element name="GetTransactionHistoryResponse">
    <xsd:complexType><xsd:sequence>
      <xsd:element name="accountId" type="xsd:string"/>
      <xsd:element name="transaction" minOccurs="0" maxOccurs="unbounded">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="txnId"      type="xsd:long"/>
          <xsd:element name="postedAt"   type="xsd:dateTime"/>
          <xsd:element name="amount"     type="xsd:decimal"/>
          <xsd:element name="narrative"  type="xsd:string" minOccurs="0"/>
          <xsd:element name="transferId" type="xsd:string" minOccurs="0"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="continuationKey" type="xsd:long" minOccurs="0"/>
    </xsd:sequence></xsd:complexType>
  </xsd:element>
</xsd:schema>
