BROKER SCHEMA hpb.account
PATH hpb.common;

DECLARE NS NAMESPACE 'http://harbourpoint.example/bank/v1';

/* R7: every channel except BRANCH sees only the last 4 digits */
CREATE FUNCTION MaskAccount(IN id CHARACTER, IN channel CHARACTER) RETURNS CHARACTER
BEGIN
	IF channel = 'BRANCH' OR LENGTH(id) <= 4 THEN
		RETURN id;
	END IF;
	RETURN REPLICATE('*', LENGTH(id) - 4) || RIGHT(id, 4);
END;

/* Pence (INTEGER) to pounds (DECIMAL, 2 places) */
CREATE FUNCTION Pounds(IN minor INTEGER) RETURNS DECIMAL
BEGIN
	RETURN ROUND(CAST(minor AS DECIMAL) / 100, 2);
END;

CREATE COMPUTE MODULE Account_Dispatch
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		SET OutputRoot = InputRoot;
		IF Environment.HPB.Operation = 'GetAccountSummaryRequest' THEN
			PROPAGATE TO TERMINAL 'out';
		ELSEIF Environment.HPB.Operation = 'GetTransactionHistoryRequest' THEN
			PROPAGATE TO TERMINAL 'out1';
		ELSE
			CALL Fail('HPB-400-OPERATION', 'Unknown operation', 'Client');
		END IF;
		RETURN FALSE;
	END;
END MODULE;

/* GetAccountSummary: R6, R7, R8 */
CREATE COMPUTE MODULE Account_GetSummary
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		DECLARE channel CHARACTER Environment.HPB.ChannelId;
		-- R8: ids are matched case-insensitively through UPPER()
		DECLARE id CHARACTER UPPER(TRIM(COALESCE(Environment.HPB.Req.NS:accountId, '')));

		SET Environment.Acct.Row[] = PASSTHRU(
			'SELECT account_id, cust_id, product, sort_code, ledger_bal_minor, overdraft_limit_minor, status ' ||
			'FROM account WHERE UPPER(account_id) = ?', id);
		IF CARDINALITY(Environment.Acct.Row[]) = 0 THEN
			CALL Fail('HPB-404-ACCOUNT', 'Account not found', 'Client');
		END IF;
		DECLARE a REFERENCE TO Environment.Acct.Row[1];

		-- R8: closed account
		IF a.status = 'C' THEN
			CALL Fail('HPB-410-ACCOUNT-CLOSED', 'Account is closed', 'Client');
		END IF;

		-- R6: holds that have not expired
		SET Environment.Acct.Hold[] = PASSTHRU(
			'SELECT COALESCE(SUM(amount_minor), 0) AS holds FROM account_hold ' ||
			'WHERE account_id = ? AND expires_at > now()', a.account_id);
		DECLARE holdsMinor INTEGER CAST(Environment.Acct.Hold[1].holds AS INTEGER);

		DECLARE available INTEGER a.ledger_bal_minor + a.overdraft_limit_minor - holdsMinor;   -- R6
		DECLARE frozen BOOLEAN (a.status = 'F');
		IF frozen THEN
			SET available = 0;                                                                 -- R8
		END IF;

		SET OutputRoot = InputRoot;
		DELETE FIELD OutputRoot.SOAP.Header;
		DELETE FIELD OutputRoot.SOAP.Body;
		CREATE LASTCHILD OF OutputRoot.SOAP NAME 'Body';
		CREATE LASTCHILD OF OutputRoot.SOAP.Body AS resp NAMESPACE NS NAME 'GetAccountSummaryResponse';
		SET resp.NS:accountId        = MaskAccount(a.account_id, channel);
		SET resp.NS:customerId       = a.cust_id;
		SET resp.NS:product          = TRIM(a.product);
		SET resp.NS:sortCode         = a.sort_code;
		SET resp.NS:currency         = 'GBP';
		SET resp.NS:ledgerBalance    = Pounds(a.ledger_bal_minor);
		SET resp.NS:overdraftLimit   = Pounds(a.overdraft_limit_minor);
		SET resp.NS:holdsTotal       = Pounds(holdsMinor);
		SET resp.NS:availableBalance = Pounds(available);
		SET resp.NS:frozen           = frozen;
		SET Environment.HPB.Outcome  = 'OK';
		RETURN TRUE;
	END;
END MODULE;

/* GetTransactionHistory: R7, R9, R10 */
CREATE COMPUTE MODULE Account_GetHistory
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		DECLARE req REFERENCE TO Environment.HPB.Req;
		DECLARE channel CHARACTER Environment.HPB.ChannelId;
		DECLARE id CHARACTER UPPER(TRIM(COALESCE(req.NS:accountId, '')));
		-- dates arrive as xs:date text (yyyy-MM-dd); the database parses them
		DECLARE fromD CHARACTER TRIM(COALESCE(req.NS:fromDate, ''));
		DECLARE toD   CHARACTER TRIM(COALESCE(req.NS:toDate, ''));

		-- R9: pageSize defaults to 20 and is quietly capped at 50 (no error)
		DECLARE pageSize INTEGER 20;
		IF req.NS:pageSize IS NOT NULL THEN
			SET pageSize = CAST(req.NS:pageSize AS INTEGER);
			IF pageSize < 1 THEN SET pageSize = 20; END IF;
			IF pageSize > 50 THEN SET pageSize = 50; END IF;
		END IF;
		DECLARE contKey INTEGER COALESCE(CAST(req.NS:continuationKey AS INTEGER), 0);

		-- R10: more than 366 days (or an inverted range) is rejected
		SET Environment.Acct.Span[] = PASSTHRU('SELECT (CAST(? AS date) - CAST(? AS date)) AS days', toD, fromD);
		IF Environment.Acct.Span[1].days < 0 OR Environment.Acct.Span[1].days > 366 THEN
			CALL Fail('HPB-400-RANGE', 'Date range must be between 0 and 366 days', 'Client');
		END IF;

		SET Environment.Acct.Row[] = PASSTHRU('SELECT account_id FROM account WHERE UPPER(account_id) = ?', id);
		IF CARDINALITY(Environment.Acct.Row[]) = 0 THEN
			CALL Fail('HPB-404-ACCOUNT', 'Account not found', 'Client');
		END IF;
		DECLARE accId CHARACTER Environment.Acct.Row[1].account_id;

		-- R9: newest first by POSTED_AT then TXN_ID. toDate runs to the end of that
		-- day in Europe/London. continuationKey is the last TXN_ID already returned.
		-- One extra row is fetched to know whether another page exists.
		SET Environment.Acct.Txn[] = PASSTHRU(
			'SELECT txn_id, ' ||
			'       to_char(posted_at AT TIME ZONE ''UTC'', ''YYYY-MM-DD"T"HH24:MI:SS"Z"'') AS posted_at, ' ||
			'       amount_minor, narrative, transfer_id ' ||
			'FROM ledger_entry ' ||
			'WHERE account_id = ? ' ||
			'  AND posted_at >= (CAST(? AS date)::timestamp AT TIME ZONE ''Europe/London'') ' ||
			'  AND posted_at <  ((CAST(? AS date) + 1)::timestamp AT TIME ZONE ''Europe/London'') ' ||
			'  AND (? = 0 OR (posted_at, txn_id) < ' ||
			'        (SELECT posted_at, txn_id FROM ledger_entry WHERE txn_id = ?)) ' ||
			'ORDER BY posted_at DESC, txn_id DESC ' ||
			'LIMIT ' || CAST(pageSize + 1 AS CHARACTER),
			accId, fromD, toD, contKey, contKey);

		DECLARE total INTEGER CARDINALITY(Environment.Acct.Txn[]);
		DECLARE shown INTEGER total;
		IF shown > pageSize THEN SET shown = pageSize; END IF;

		SET OutputRoot = InputRoot;
		DELETE FIELD OutputRoot.SOAP.Header;
		DELETE FIELD OutputRoot.SOAP.Body;
		CREATE LASTCHILD OF OutputRoot.SOAP NAME 'Body';
		CREATE LASTCHILD OF OutputRoot.SOAP.Body AS resp NAMESPACE NS NAME 'GetTransactionHistoryResponse';
		SET resp.NS:accountId = MaskAccount(accId, channel);                                    -- R7

		DECLARE i INTEGER 1;
		WHILE i <= shown DO
			CREATE LASTCHILD OF resp AS t NAMESPACE NS NAME 'transaction';
			SET t.NS:txnId    = Environment.Acct.Txn[i].txn_id;
			SET t.NS:postedAt = Environment.Acct.Txn[i].posted_at;
			SET t.NS:amount   = Pounds(Environment.Acct.Txn[i].amount_minor);
			IF Environment.Acct.Txn[i].narrative IS NOT NULL THEN
				SET t.NS:narrative = Environment.Acct.Txn[i].narrative;
			END IF;
			IF Environment.Acct.Txn[i].transfer_id IS NOT NULL THEN
				SET t.NS:transferId = Environment.Acct.Txn[i].transfer_id;
			END IF;
			SET i = i + 1;
		END WHILE;
		IF total > pageSize THEN
			SET resp.NS:continuationKey = Environment.Acct.Txn[shown].txn_id;
		END IF;
		SET Environment.HPB.Outcome = 'OK';
		RETURN TRUE;
	END;
END MODULE;
